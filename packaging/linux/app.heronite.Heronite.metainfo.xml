<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream data: software centres (GNOME Software, Discover) show it for the packages. -->
<component type="desktop-application">
  <id>app.heronite.Heronite</id>
  <name>Heronite</name>
  <summary>Play all your games in one place</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="app.heronite">
    <name>RafaGoulartB</name>
  </developer>
  <description>
    <p>
      Heronite gathers your games from Steam, Epic Games, GOG, Amazon Games, Battle.net,
      EA app, Ubisoft Connect and Rockstar Games, plus emulated ROMs and native Linux and
      Windows games, in one Collection, and launches them natively, with Wine or Proton,
      or through an emulator.
    </p>
    <ul>
      <li>Install, update and repair Epic, GOG and Amazon games from one download queue</li>
      <li>Statuses, ratings, playtime, sessions, statistics and a year in review</li>
      <li>Metadata and artwork from IGDB, SteamGridDB, Steam and Lutris</li>
      <li>Wine and Proton manager, save backups with Ludusavi</li>
      <li>Emulator detection, ROM folder scanning and RetroAchievements</li>
      <li>A controller-first console mode with shareable themes</li>
    </ul>
  </description>
  <launchable type="desktop-id">app.heronite.Heronite.desktop</launchable>
  <url type="homepage">https://heronite.app</url>
  <url type="vcs-browser">https://github.com/RafaelGoulartB/Heronite</url>
  <url type="bugtracker">https://github.com/RafaelGoulartB/Heronite/issues</url>
