{
  "index": 1,
  "name": "Heronite",
  "extensions": [
    {
      "id": "pcgamingwiki",
      "name": "PCGamingWiki",
      "version": "1.0.0",
      "api": 1,
      "author": "Heronite",
      "homepage": "https://www.pcgamingwiki.com",
      "kind": "extras",
      "adult": false,
      "description": "Controller support, ultra-wide screens, HDR and ray tracing of PC games, and their series, from PCGamingWiki. Found by the Steam id when the game has one, else by its name.",
      "fields": [
        "series",
        "features"
      ],
      "applies": {
        "to": "pc"
      },
      "hosts": [
        "www.pcgamingwiki.com"
      ],
      "images": [],
      "settings": [],
