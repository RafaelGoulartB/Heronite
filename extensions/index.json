      }
    },
    {
      "id": "wikipedia",
      "name": "Wikipedia",
      "version": "1.0.0",
      "api": 1,
      "author": "Heronite",
      "homepage": "https://www.wikipedia.org",
      "kind": "details",
      "adult": false,
      "description": "The first paragraphs of the game's Wikipedia article, in your language when there is one. Asked only when the other sources lack the game.",
